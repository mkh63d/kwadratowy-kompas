{
  "name": "hacknation-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "convex dev --start \"vite\"",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "convex run notes/seed:run",
    "lane:new": "node scripts/lane.mjs new",
    "lane:list": "node scripts/lane.mjs list",
    "lane:rm": "node scripts/lane.mjs rm",
    "overlap": "node scripts/overlap.mjs",
    "setup:deploy": "node scripts/setup-deploy.mjs",
    "codegen:check": "node scripts/codegen-check.mjs",
    "verify": "run-s format:check lint typecheck test:coverage build test:e2e"
  },
  "dependencies": {
    "@sentry/react": "11.12.0",
    "convex": "1.50.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sentry/vite-plugin": "11.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "convex-test": "0.0.71",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "npm-run-all2": "9.0.4",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
