# Template for local settings. Copy to .env.local and fill in. Never commit real values.
# VITE_* variables are embedded in the browser bundle, so never put a secret under that prefix.
# Vite does not read AI_* or GitHub secrets from here; see the sections below.

# Frontend. Local: copy the URL from `npx convex dev`. Vercel build: set by `npx convex deploy`.
# Leave empty to run in offline mode (no Convex client, offline banner shown).
# Never set it in the Vercel project env. Do not export it in the shell either:
# `npm run test:e2e` fails fast when it is set.
VITE_CONVEX_URL=

# Frontend, optional. Local or Vercel build. Public by design. Empty = Sentry never starts.
# Never set it in .env.e2e: the e2e and CI builds stay Sentry-free.
VITE_SENTRY_DSN=
# Frontend, optional. Release name for Sentry. Set by the deploy workflow to the commit SHA.
# VITE_COMMIT_SHA=

# Local only. Written by `npx convex dev`; do not write it by hand. For a credential-free local
# deployment, set CONVEX_AGENT_MODE=anonymous in the shell before running `npx convex dev`.
# CONVEX_DEPLOYMENT=dev:<your-deployment-name>

# Convex deployment environment (per deployment). Not read from this file.
# Set each one with: npx convex env set <NAME> <value>
# AI_PROVIDER=mock                              # Convex env. mock (default) | openai-compatible
# AI_BASE_URL=https://ai.test.invalid/v1        # Convex env. Required for openai-compatible. https only,
#                                               # http only for localhost
# AI_MODEL=<your-model-name>                    # Convex env. Required for openai-compatible
# AI_API_KEY=<your-api-key>                     # Convex env, secret. Bearer token for the endpoint
# AI_TIMEOUT_MS=20000                           # Convex env. Default 20000
# AI_MAX_RETRIES=1                              # Convex env. Default 1
# AI_STRUCTURED_MODE=json_schema                # Convex env. Default json_schema

# GitHub secrets (repo Settings > Secrets and variables). Read by the deploy workflow only.
# CONVEX_DEPLOY_KEY=prod:<production-deploy-key>   # GitHub secret, secret. Production deploy key
# VERCEL_TOKEN=<vercel-token>                       # GitHub secret, secret
# VERCEL_ORG_ID=<vercel-org-id>                     # GitHub secret
# VERCEL_PROJECT_ID=<vercel-project-id>             # GitHub secret
# SENTRY_AUTH_TOKEN=<sentry-auth-token>             # GitHub secret, secret. Optional, source map upload
# SENTRY_ORG=<sentry-org-slug>                      # GitHub variable. Optional, source map upload
# SENTRY_PROJECT=<sentry-project-slug>              # GitHub variable. Optional, source map upload
